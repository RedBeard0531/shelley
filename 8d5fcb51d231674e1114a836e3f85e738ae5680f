      "patch": "diff --git a/server/expand_tilde_test.go b/server/expand_tilde_test.go\nnew file mode 100644\nindex 00000000..88a5e47b\n--- /dev/null\n+++ b/server/expand_tilde_test.go\n@@ -0,0 +1,30 @@\n+package server\n+\n+import (\n+\t\"os\"\n+\t\"path/filepath\"\n+\t\"testing\"\n+)\n+\n+// expandTilde resolves a leading ~ to the user's home directory so the web\n+// editor can open home-relative paths from file references.\n+func TestExpandTilde(t *testing.T) {\n+\tt.Parallel()\n+\thome, err := os.UserHomeDir()\n+\tif err != nil {\n+\t\tt.Fatalf(\"UserHomeDir: %v\", err)\n+\t}\n+\tfor _, tc := range []struct{ in, want string }{\n+\t\t{\"~/foo/bar\", filepath.Join(home, \"foo/bar\")},\n+\t\t{\"~\", home},\n+\t\t{\"~/.config/shelley/AGENTS.md\", filepath.Join(home, \".config/shelley/AGENTS.md\")},\n+\t\t{\"/abs/path\", \"/abs/path\"},\n+\t\t{\"relative/path\", \"relative/path\"},\n+\t\t{\"~user/x\", \"~user/x\"}, // ~user is not expanded\n+\t\t{\"a~b/c\", \"a~b/c\"},     // mid-path tilde is not expanded\n+\t} {\n+\t\tif got := expandTilde(tc.in); got != tc.want {\n+\t\t\tt.Errorf(\"expandTilde(%q) = %q, want %q\", tc.in, got, tc.want)\n+\t\t}\n+\t}\n+}\n",
      "comment": "expandTilde's table: `~`, `~/...`, absolute, relative, and the non-expansions (`~user`, mid-path tilde)."
