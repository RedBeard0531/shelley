      "patch": "diff --git a/ui/src/styles.css b/ui/src/styles.css\nindex cab0c7a8..0f79ba59 100644\n--- a/ui/src/styles.css\n+++ b/ui/src/styles.css\n@@ -9332,6 +9332,25 @@ kbd {\n   text-decoration: none;\n }\n \n+/* File references (`path:line` inline code rendered as a link): a monospace\n+   chip with a link affordance, so they read as code but invite a click.\n+   Gated on the data attribute, not just the class, so forged class-only\n+   anchors don't get the affordance. */\n+.markdown-content a.file-ref[data-file-path] {\n+  font-family: var(--font-mono);\n+  font-size: 0.875rem;\n+  background: var(--code-bg);\n+  padding: 0.15em 0.35em;\n+  border-radius: 4px;\n+  color: var(--link-color);\n+  text-decoration: none;\n+  cursor: pointer;\n+}\n+\n+.markdown-content a.file-ref[data-file-path]:hover {\n+  text-decoration: underline;\n+}\n+\n .markdown-content del {\n   text-decoration: line-through;\n   color: var(--text-secondary);\n",
